# MongoDB Atlas connection string (database name: events-board)
MONGODB_URI="mongodb+srv://<username>:<password>@<cluster>.mongodb.net/events-board?retryWrites=true&w=majority"
# Long random text, at least 32 characters. Used to sign login tokens.
JWT_SECRET="change-me-to-a-long-random-string"
# Hard-coded admin login
ADMIN_EMAIL="admin@eventsboard.com"
ADMIN_PASSWORD="Admin@12345"